{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    {
      "kind": "group",
      "path": "SafariAgent",
      "children": [
        {
          "kind": "group",
          "path": "App",
          "children": [
            { "path": "main.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "AppDelegate.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "SettingsView.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
          ],
        },
        {
          "kind": "group",
          "path": "Picker",
          "children": [
            { "path": "PickerController.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "PickerDesigns.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "HistoryPanel.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
          ],
        },
        {
          "kind": "group",
          "path": "Core",
          "children": [
            { "path": "Support.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "Prompts.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "WebSocketServer.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "ConversationStore.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "Hub.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "MCPBridge.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "AppSettings.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "NativeTools.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "Profiles.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "Routing.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "SessionSharing.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "SafariDockWatcher.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "HistoryStore.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
