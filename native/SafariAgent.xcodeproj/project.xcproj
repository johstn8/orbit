          "children": [
            { "path": "ClaudeProvider.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "ChatGPTAuth.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
            { "path": "ChatGPTProvider.swift", "target-membership": [ "SafariAgent/compile-sources" ] },
