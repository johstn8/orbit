        { "path": "Assets.xcassets", "target-membership": [ "SafariAgent/resources" ] },
        { "path": "Info.plist" },
        { "path": "SafariAgent.entitlements" },
      ],
    }, {
      "kind": "group",
      "path": "SafariAgentExtension",
      "children": [
        {
          "kind": "group",
          "path": "<PROJECT>/../extension/dist",
          "name": "Web Extension (built)",
          "children": [
            { "path": "manifest.json", "target-membership": [ "SafariAgentExtension/resources" ] },
            { "path": "background.js", "target-membership": [ "SafariAgentExtension/resources" ] },
            { "path": "content.js", "target-membership": [ "SafariAgentExtension/resources" ] },
            { "path": "panel.html", "target-membership": [ "SafariAgentExtension/resources" ] },
            { "path": "panel.js", "target-membership": [ "SafariAgentExtension/resources" ] },
            { "path": "panel.css", "target-membership": [ "SafariAgentExtension/resources" ] },
            { "path": "icons", "target-membership": [ "SafariAgentExtension/resources" ] },
            { "path": "_locales", "target-membership": [ "SafariAgentExtension/resources" ] },
          ],
        },
        { "path": "SafariWebExtensionHandler.swift", "target-membership": [ "SafariAgentExtension/compile-sources" ] },
        { "path": "Info.plist" },
        { "path": "SafariAgentExtension.entitlements" },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Orbit.app", "id": "5A0E00000000000000000001", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/SafariAgentExtension.appex", "id": "5A0E00000000000000000002", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "SafariAgent/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "SafariAgent",
      "id": "5A0E00000000000000000010",
      "product": "Products/Orbit.app",
      "product-type": "application",
      "dependencies": [
        "SafariAgentExtension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "SafariAgent/SafariAgent.entitlements",
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_STYLE": "Manual",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "8",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "SafariAgent/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Orbit",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "INFOPLIST_KEY_NSPrincipalClass": "NSApplication",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "14.0",
        "MARKETING_VERSION": "1.1.10",
        "OTHER_LDFLAGS": [
          "-framework",
          "SafariServices",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.local.SafariAgent",
        "PRODUCT_MODULE_NAME": "SafariAgent",
        "PRODUCT_NAME": "Orbit",
        "SWIFT_VERSION": "5.0",
      },
    }, {
      "name": "SafariAgentExtension",
      "id": "5A0E00000000000000000020",
      "product": "Products/SafariAgentExtension.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "SafariAgentExtension/SafariAgentExtension.entitlements",
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_STYLE": "Manual",
        "CURRENT_PROJECT_VERSION": "8",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "SafariAgentExtension/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Orbit Extension",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@executable_path/../../../../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "14.0",
        "MARKETING_VERSION": "1.1.10",
        "OTHER_LDFLAGS": [
          "-framework",
          "SafariServices",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.local.SafariAgent.Extension",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SKIP_INSTALL": "YES",
        "SWIFT_VERSION": "5.0",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "MACOSX_DEPLOYMENT_TARGET": "14.0",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "macosx",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
  },
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
}
